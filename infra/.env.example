# Contoh untuk pengembangan lokal. Jangan commit infra/.env. Produksi: injeksi dari secret manager (13_DEPLOYMENT_RUNBOOK.md).
POSTGRES_PASSWORD=change-me-local-only
SIB_MIGRATOR_PASSWORD=change-me-local-only
SIB_APP_PASSWORD=change-me-local-only
# base64 dari 32 byte acak:  openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# Login staf OIDC (kosongkan untuk menonaktifkan; GET /auth/staff/login -> 501)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# harus persis sama dengan redirect URI yang didaftarkan di IdP, mis. https://<host>/api/v1/auth/staff/callback
OIDC_REDIRECT_URL=
# MFA (amr=mfa) wajib untuk peran privilese; set false hanya untuk IdP staging tanpa MFA
OIDC_REQUIRE_MFA=true
